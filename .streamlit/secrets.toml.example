# Copy to .streamlit/secrets.toml (git-ignored) for local runs, or paste into
# Streamlit Community Cloud → App settings → Secrets. Every key is optional.

# Gemini agent mode (https://aistudio.google.com/apikey)
GEMINI_API_KEY = ""
# One case = ~11 model calls. Free keys allow only ~20 requests/day on the bigger flash models, and
# gemini-flash-latest often answers 503 "high demand"; flash-lite has a larger free quota and is faster.
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Claude agent mode, runs on Claude Haiku 5.5 (https://platform.claude.com/settings/keys). Billed per token.
ANTHROPIC_API_KEY = ""

# Case history in Supabase: Project settings → API.
# Use the server-side SECRET key (sb_secret_… / service_role). Never put it in client-side code.
SUPABASE_URL = ""
SUPABASE_KEY = ""
